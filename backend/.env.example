# Server Configuration
PORT=5001
NODE_ENV=production

# Database (MongoDB Atlas or persistent URI required in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bis_sahayak?retryWrites=true&w=majority

# Security & Authentication (Generate a strong 64-char secret)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Supabase Authentication (For Google OAuth & User Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Frontend & CORS Configuration (Comma-separated for multiple origins, e.g. Vercel)
CORS_ORIGIN=https://bis-sahayak.vercel.app,http://localhost:5173
FRONTEND_URL=https://bis-sahayak.vercel.app

# RAG & Domain Engine URL (FastAPI Service on port 8000)
RAG_API_URL=http://127.0.0.1:8000

# Google Gemini AI Configuration (Server-Side Only)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Groq LLM API Key (Alternative/Fallback RAG generation)
GROQ_API_KEY=your_groq_api_key_here

# Bhashini Indic Translation API (Optional)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Model Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
CHROMA_PERSIST_DIR=./data/chroma_db
